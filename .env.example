# Local development: copy to .env.local
DATABASE_URL=postgres://ci:ci@localhost:5432/ci
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TRUST_HOST=true
# Microsoft 365 sign-in (Entra app "Chesson Investments", Technical Source tenant)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
# Comma-separated; these become Owners on first sign-in. Everyone else must be added by an Owner.
OWNER_EMAILS=mchesson@technicalsource.com
# Only under `npm run dev`: sample sign-in buttons. Never in Vercel.
DEV_LOGIN=true
# Optional: private Supabase Storage bucket for files (else files stay in the database)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
